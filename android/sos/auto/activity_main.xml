<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Contenedor del Mapa Interactivo (Waze / Google Maps / Vista de Ruta) -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Aquí se renderiza el mapa interactivo con alertas de tráfico y fotodetección -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🗺️ [ Mapa Interactivo - S.O.S. Auto ]"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/darker_gray" />

    </FrameLayout>

    <!-- Banner Publicitario No Intrusivo (Inferior / Superior) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#DD000000"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="📢 Aliados S.O.S. Auto | Paute con nosotros (Wompi)"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Barra de Mandos Flotante / Acceso Rápido -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:layout_marginBottom="48dp"
        android:orientation="vertical"
        android:gravity="end">

        <!-- Botón: Paute con Nosotros -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="Paute con Nosotros"
            app:backgroundTint="@android:color/holo_blue_dark"
            app:fabSize="mini"
            app:tint="@android:color/white" />

        <!-- Botón: Estoy Varado (Amarillo) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabVarado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="Estoy Varado"
            app:backgroundTint="@android:color/holo_orange_light"
            app:fabSize="normal"
            app:tint="@android:color/white" />

        <!-- Botón: Robo de Auto (Naranja/Rojo Oscuro) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabRobo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="Robo de Auto"
            app:backgroundTint="@android:color/holo_orange_dark"
            app:fabSize="normal"
            app:tint="@android:color/white" />

        <!-- Botón: Estoy en Peligro (Rojo) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabDanger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Estoy en Peligro"
            app:backgroundTint="@android:color/holo_red_dark"
            app:fabSize="normal"
            app:tint="@android:color/white" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
